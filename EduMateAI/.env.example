# Copy this file to .env and fill in what you need. Every value is optional.

# Port for the API server in development (Vite proxies /api to it).
# In production (`npm start`) the server uses $PORT if your host sets it, otherwise 4000.
API_PORT=4000

# Secret used to sign login sessions. If empty, a random one is generated once
# and saved to server/data/.session-secret. Set it explicitly when you deploy.
JWT_SECRET=

# Where the SQLite database and uploaded files are stored.
DATABASE_FILE=server/data/edumate.db
UPLOAD_DIR=server/uploads

# Turns on real AI answers in the Assistant and "Generate with AI" for modules.
# Without a key the Assistant answers from your own flashcards and notes.
#
# Google Gemini (free tier): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the main model is busy, rate-limited or retired.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Or use Claude instead (paid): set ANTHROPIC_API_KEY and AI_PROVIDER=anthropic.
# AI_PROVIDER picks one when both keys are set; if empty, Gemini is used when its key is present.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to false to skip creating the demo account on a fresh database.
SEED_DEMO=true
