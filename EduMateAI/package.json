{
  "name": "edumate-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:full": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev\"",
    "start": "node --disable-warning=ExperimentalWarning server/index.js --prod",
    "db:reset": "node -e \"require('fs').rmSync('server/data',{recursive:true,force:true})\"",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "start:lan": "node --disable-warning=ExperimentalWarning server/index.js --prod --lan",
    "cap:sync": "vite build && cap sync android",
    "android": "pnpm cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
